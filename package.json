{
  "name": "simply-task-board",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "start": "firebase emulators:start",
    "start:seed": "firebase emulators:start --import=firebase-test-data",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "cypress open",
    "e2e:test": "cypress open --config-file cypress.config.test.ts",
    "build:test": "ng build -c test",
    "deploy": ". ./deploy/deploy.sh",
    "deploy:test": "npm run build:test && firebase deploy --project test-simply-task-board --only hosting:test"
  },
  "dependencies": {
    "@angular/animations": "^20.2.3",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "^20.2.3",
    "@angular/compiler": "^20.2.3",
    "@angular/core": "^20.2.3",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.2.3",
    "@angular/material": "^20.2.1",
    "@angular/platform-browser": "^20.2.3",
    "@angular/platform-browser-dynamic": "^20.2.3",
    "@angular/router": "^20.2.3",
    "@firebase/util": "^1.13.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.3",
    "@types/jest": "^30.0.0",
    "cypress": "^13.17.0",
    "firebase-tools": "^14.15.1",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "jest-mock-extended": "^4.0.0",
    "jest-preset-angular": "^15.0.0",
    "ng-mocks": "^14.13.5",
    "prettier": "3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
